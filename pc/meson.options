option('build_target', type: 'combo', choices: ['linux', 'win64'], value: 'linux', description: 'Native runtime platform')
option('game_version', type: 'combo', choices: ['heartgold', 'soulsilver'], value: 'heartgold')
option('tracy_enable', type: 'boolean', value: false, description: 'SDK profiling', yield: true)

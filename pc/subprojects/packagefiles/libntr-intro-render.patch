+// Optional subpixel sampling residuals for native 2D animations (BG0-3, OBJ).
+static float s_LayerOffset[2][8][2] = {};
+extern "C" void SIM_Set2DObjOffset(int screen, int priority, s32 x, s32 y) {
+  if (screen < 0 || screen > 1 || priority < 0 || priority > 3) return;
+  s_LayerOffset[screen][4 + priority][0] = (float)x / (4096.0f * 256.0f);
+  s_LayerOffset[screen][4 + priority][1] = (float)-y / (4096.0f * 384.0f);
+}
+extern "C" void SIM_Set2DLayerOffset(int screen, int layer, s32 x, s32 y) {
+  if (screen < 0 || screen > 1 || layer < 0 || layer > 4) return;
+  if (layer == 4) {
+    for (int priority = 0; priority < 4; ++priority) SIM_Set2DObjOffset(screen, priority, x, y);
+    return;
+  }
+  s_LayerOffset[screen][layer][0] = (float)x / (4096.0f * 256.0f);
+  s_LayerOffset[screen][layer][1] = (float)-y / (4096.0f * 384.0f);
+}

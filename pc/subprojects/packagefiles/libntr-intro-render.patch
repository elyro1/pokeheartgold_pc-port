+vec4 sampleScrolledLayer(sampler2D layerTexture, vec2 offset, bool sprite) {
+    if (all(equal(offset, vec2(0.0)))) return texture(layerTexture, uiCoord);
+    vec2 coord = uiCoord + offset;
+    float bottom = topScreen == 1 ? 0.5 : 0.0;
+    // These textures contain rasterized screens, not repeating tile maps.
+    // A fractional shift must not fetch the opposite edge or the other LCD.
+    if (sprite) {
+        if (coord.x < 0.0 || coord.x >= 1.0 || coord.y < bottom || coord.y >= bottom + 0.5)
+            return vec4(0.0);
+    } else {
+        vec2 halfTexel = 0.5 / vec2(256.0, 384.0);
+        coord = clamp(coord, vec2(0.0, bottom) + halfTexel,
+            vec2(1.0, bottom + 0.5) - halfTexel);
+    }
+    return texture(layerTexture, coord);
+}
